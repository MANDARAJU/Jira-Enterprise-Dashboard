# Copy to .env for local development. Do not commit the real .env file.
NODE_ENV=development
PORT=3000
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=service-account@example.com
JIRA_API_TOKEN=replace-with-jira-api-token
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jira_dashboard
DB_USER=postgres
DB_PASSWORD=replace-with-database-password
# Required when NODE_ENV=production; comma-separated browser origins.
CORS_ALLOWED_ORIGINS=https://dashboard.example.com
